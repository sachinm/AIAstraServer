  @@index([actor_admin_id, created_at(sort: Desc)], map: "admin_actions_actor_admin")
  @@index([created_at(sort: Desc)], map: "admin_actions_created")
  @@map("admin_actions")
}

/// Staff accounts for the admin app (M25, aiadastra_admin). Kept apart from customer accounts in `auth`. The password is
