  failed_attempts Int           @default(0) @map("failed_attempts")
  locked_until    DateTime?     @map("locked_until") @db.Timestamptz(6)
  last_login_at   DateTime?     @map("last_login_at") @db.Timestamptz(6)
  last_login_ip   String?       @map("last_login_ip")
  created_at      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  actions         AdminAction[]
  techniqueReviews TechniqueReview[]

  @@map("admin_accounts")
}

