generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Auth {
  id                         String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  username                   String
  password                   String
  date_of_birth              String
  place_of_birth             String?
  time_of_birth              String?
  email                      String
  gender                     String?
  is_active                  Boolean?               @default(true)
  kundli_added               Boolean?               @default(false)
  role                       String?                @default("user")
  created_at                 DateTime               @default(now()) @map("created_at")
  /// Client IP at account creation (from proxy headers when present).
  signup_ip                  String?                @map("signup_ip")
  /// Bcrypt hash of the current magic-link code (plain code is only sent by email).
  magic_link_code_hash       String?                @map("magic_link_code_hash")
  magic_link_expires_at      DateTime?              @map("magic_link_expires_at") @db.Timestamptz(6)
  /// AUTH_PROVIDER=cognito: the InitiateAuth Session parked between requestMagicLink and loginWithMagicLink.
  cognito_session            String?                @map("cognito_session")
  cognito_session_expires_at DateTime?              @map("cognito_session_expires_at") @db.Timestamptz(6)
  /// Registration v2 (migration 20261027140000_registration_v2). Full name from page 1 of signup.
  name                       String?
  /// ISO 3166-1 alpha-2, upper case (page 2).
  country_code               String?                @map("country_code")
  /// Free-text birth city (page 2).
  city                       String?
  /// Set when the emailed code is accepted. Null = pending signup.
  email_verified_at          DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  /// False for a signup that verified its email but has not saved page 2. Existing users default true.
  profile_complete           Boolean                @default(true) @map("profile_complete")
  /// The user's own shareable code, 8 characters from [A-Z2-9].
  referral_code              String?                @unique @map("referral_code")
  referred_by_user_id        String?                @map("referred_by_user_id")
  referred_by                Auth?                  @relation("Referrals", fields: [referred_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referrals                  Auth[]                 @relation("Referrals")
  chats                      Chat[]
  readingRuns                ReadingRun[]
  agent_responses            ReadingAgentResponse[]
  reading_traces             ReadingTrace[]
  prashnaCasts               PrashnaCast[]
  kundlis                    Kundli[]
  userGeneratedContent       UserGeneratedContent[]
  billing_account            BillingAccount?
  question_usage             QuestionUsage[]
  /// en | hi, asked at registration. Readings are English until Hindi ships (docs/billing/README.md).
  language                   String                 @default("en")
  /// Shows the full charts and dashas in the chat's right sidebar.
  research                   Boolean                @default(false)
  /// M23 (docs/admin/01): set when an admin locks the account; every request and sign-in is refused while set.
  locked_at                  DateTime?              @map("locked_at") @db.Timestamptz(6)
  locked_reason              String?                @map("locked_reason")
  /// auth.id of the admin, or 'cli' / 'system'.
  locked_by                  String?                @map("locked_by")
  /// Compared with the JWT `tv` claim; bumping it ends every session of this account.
  token_version              Int                    @default(1) @map("token_version")
  /// Updated at most once per 5 minutes per user by request auth.
  last_seen_at               DateTime?              @map("last_seen_at") @db.Timestamptz(6)
  /// Terms of Use version last accepted (src/auth/terms.ts); migration 20261108120000_auth_terms_acceptance.
  terms_version              String?                @map("terms_version")
  terms_accepted_at          DateTime?              @map("terms_accepted_at") @db.Timestamptz(6)
  /// When the person last confirmed they are 18 or older (same checkbox as the Terms).
  age_confirmed_at           DateTime?              @map("age_confirmed_at") @db.Timestamptz(6)
  activity_days              UserActivityDay[]
  feature_overrides          UserFeatureOverride[]
  admin_actions_done         AdminAction[]          @relation("AdminActionActor")
  admin_actions_on           AdminAction[]          @relation("AdminActionTarget")
  luckyPref                  LuckyPref?
  luckyPicks                 LuckyScenarioPick[]
  agentRuns                  AgentRun[]
  analyticsEvents            AnalyticsEvent[]

  @@index([created_at(sort: Desc)], map: "auth_created_at")
  areaBuilds         AreaBuild[]
  areaChecks         AreaCheck[]
  personFacts        PersonFact[]

  profilePhoto       ProfilePhoto?
  photoAttempts      ProfilePhotoAttempt[]

  @@map("auth")
}

model Kundli {
  id                 String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id            String
  biodata            Json?
  d1                 Json?
  d2                 Json?
  d4                 Json?
  d7                 Json?
  d9                 Json?
  d10                Json?
  charakaraka        Json?
  vimsottari_dasa    Json?                  @map("vimsottari_dasa")
  narayana_dasa      Json?                  @map("narayana_dasa")
  other_readings     Json?                  @map("other_readings")
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  queue_status       String                 @default("pending") @map("queue_status")
  queue_started_at   DateTime?              @map("queue_started_at")
  queue_completed_at DateTime?              @map("queue_completed_at")
  last_sync_error    String?                @map("last_sync_error")
  /// Coordinates stored once (reading engine M1) so nothing geocodes again.
  lat                Float?
  lon                Float?
  tz                 Float?
  place_resolved     String?                @map("place_resolved")
  /// pending | building | ready | failed | unsupported (the engine does not serve the dossier yet)
  facts_status       String                 @default("pending") @map("facts_status")
  /// pending | building | ready | stale | failed (M32, docs/reading-engine/53 §4.1, 54 §2)
  digest_status      String                 @default("pending") @map("digest_status")
  digest_version     String?                @map("digest_version")
  digest_built_at    DateTime?              @map("digest_built_at") @db.Timestamptz(6)
  digest_error       String?                @map("digest_error")
  /// the reading clock the person trusts (docs/reading-engine/58 §4.1); catalogue dasha id, e.g. dwisatpathi
  preferred_dasha    String?                @map("preferred_dasha")
  facts              KundliFacts[]
  digestRows         KundliDigest[]
  activations        KundliActivation[]
  transitCharts      TransitSnapshot[]
  transitOverlays    KundliTransitOverlay[]
  dayOverlays        KundliDayOverlay[]
  chartData          KundliData[]
  user               Auth                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content            UserGeneratedContent[]

  @@index([user_id], map: "idx_kundlis_user_id")
  /// the person's latest chart (findFirst where user_id orderBy created_at desc) without a sort
  @@index([user_id, created_at(sort: Desc)], map: "idx_kundlis_user_created")
  @@index([digest_status], map: "idx_kundlis_digest_status")
  areaBuilds         AreaBuild[]
  techniqueOutputs   TechniqueOutput[]
  readingDossiers    ReadingDossier[]
  validationFailures ReadingValidationFailure[]
  boardLayouts       BoardLayout[]
  slices             KundliSlice[]

  @@map("kundlis")
}

model SystemPrompt {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name      String   @unique
  prompt    String
  is_active Boolean? @default(true) @map("is_active")

  @@map("system_prompts")
}

model UserGeneratedContent {
  id         String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id    String
  kundli_id  String
  remedies   Json?
  mantras    Json?
  routines   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  kundli     Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kundli_id], map: "idx_user_generated_content_kundli_id")
  @@index([user_id], map: "idx_user_generated_content_user_id")
  @@map("user_generated_content")
}

model Chat {
  id          String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id     String
  /// Short title shown in the UI: first user question, trimmed to 50 chars (set when the first message is saved).
  name        String?
  /// docs/reading-engine/51: general | today | you | love | work | lucky
  category    String       @default("general")
  /// set when the person pins the thread to the top of the list
  pinned_at   DateTime?    @map("pinned_at") @db.Timestamptz(6)
  is_active   Boolean      @default(true) @map("is_active")
  created_at  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Auth         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    Message[]
  chatLogs    ChatLog[]
  readingRuns ReadingRun[]

  @@index([user_id], map: "idx_chats_user_id")
  @@map("chats")
}

model Message {
  id         String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  chat_id    String
  question   String
  ai_answer  String      @map("ai_answer")
  created_at DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  chat       Chat        @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chatLog    ChatLog?
  readingRun ReadingRun?

  @@index([chat_id], map: "idx_messages_chat_id")
  @@map("messages")
}

model ChatLog {
  id                  String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  chat_id             String   @map("chat_id")
  message_id          String   @unique @map("message_id")
  request_payload     Json     @map("request_payload")
  response_payload    Json     @map("response_payload")
  /// True when the answer was delivered via POST /api/chat/ask-stream (SSE). False for GraphQL `ask`.
  /// Matches the web app when VITE_CHAT_STREAM is enabled (default); not sent from the client—set by the server.
  client_delivery_sse Boolean  @default(false) @map("client_delivery_sse")
  created_at          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chat                Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message             Message  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id], map: "idx_chat_logs_chat_id")
  @@map("chat_logs")
}

/// Chart-facts dossier per kundli and facts version (reading engine M2).
model KundliFacts {
  id            String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id     String   @map("kundli_id")
  facts_version Int      @map("facts_version")
  engine_commit String   @map("engine_commit")
  ayanamsa      String   @default("LAHIRI")
  dossier       Json
  natal_points  Json     @map("natal_points")
  dossier_hash  String   @map("dossier_hash")
  /// Hash of the legacy kundli columns the dossier was built from; a change triggers a rebuild.
  source_hash   String   @map("source_hash")
  built_at      DateTime @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli        Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kundli_id, facts_version], map: "kundli_facts_kundli_version")
  @@map("kundli_facts")
}

/// The keyword list of chart data types Radha can serve (reading engine M7, docs/reading-engine/20 §4). Seeded from
/// src/reading/chartData/catalog.ts; rows override served/tier/calc_version/enabled.
model ChartDataType {
  id            String       @id
  family        String
  radha_type    String       @map("radha_type")
  change_class  String       @map("change_class")
  tier          String
  variant_kind  String       @map("variant_kind")
  served        Boolean      @default(false)
  calc_version  String?      @map("calc_version")
  legacy_column String?      @map("legacy_column")
  sort_order    Int          @default(500) @map("sort_order")
  label         String
  enabled       Boolean      @default(true)
  updated_at    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  rows          KundliData[]

  @@map("chart_data_types")
}

/// One row per (kundli, chart data type, variant): the vertical kundli store (reading engine M7).
/// The row is also the fetch lock: status 'fetching' + fetch_started_at, reclaimable after the Radha timeout.
model KundliData {
  id               String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id        String        @map("kundli_id")
  data_type        String        @map("data_type")
  /// '' for natal rows; canonical key of params (e.g. 'year=2027') otherwise
  variant          String        @default("")
  params           Json          @default("{}")
  ayanamsa         String        @default("LAHIRI")
  calc_version     String?       @map("calc_version")
  engine_commit    String?       @map("engine_commit")
  payload          Json?
  payload_hash     String?       @map("payload_hash")
  /// ready | fetching | failed | unsupported
  status           String        @default("fetching")
  error            String?
  fetch_started_at DateTime?     @map("fetch_started_at") @db.Timestamptz(6)
  fetched_at       DateTime?     @map("fetched_at") @db.Timestamptz(6)
  valid_to         DateTime?     @map("valid_to") @db.Timestamptz(6)
  kundli           Kundli        @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type             ChartDataType @relation(fields: [data_type], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([kundli_id, data_type, variant, ayanamsa], name: "kundli_data_key", map: "kundli_data_key")
  @@index([data_type, status], map: "idx_kundli_data_type_status")
  @@map("kundli_data")
}

/// The kundli digest (M32, docs/reading-engine/53 §4.1, 54 §2): one row per (kundli, section, key), built by code from
/// the stored engine rows; `source` lists the engine type, variant, calc version and JSON path of every value.
model KundliDigest {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id      String   @map("kundli_id")
  /// house | planet | yoga | point | annual | star
  section        String
  key            String
  row            Json
  source         Json     @default("[]")
  digest_version String   @map("digest_version")
  built_at       DateTime @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli         Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kundli_id, section, key], name: "kundli_digest_key", map: "kundli_digest_key")
  @@index([kundli_id, section], map: "idx_kundli_digest_section")
  @@map("kundli_digest")
}

/// The activation calendar (M33, docs/reading-engine/53 §4.1, 54 §2): one row per stored dasha period, birth to thirty
/// years ahead, with the D1 houses it activates as the engine states them.
model KundliActivation {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id      String   @map("kundli_id")
  system         String
  family         String
  level          Int
  lord           String?
  sign           String?
  from_date      DateTime @map("from_date") @db.Date
  to_date        DateTime @map("to_date") @db.Date
  houses         Int[]    @default([])
  parent_lord    String?  @map("parent_lord")
  digest_version String   @map("digest_version")
  kundli         Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kundli_id, from_date, to_date], map: "idx_kundli_activation_range")
  @@index([kundli_id, level, from_date, to_date], map: "idx_kundli_activation_level_range")
  @@index([houses], map: "idx_kundli_activation_houses", type: Gin)
  @@map("kundli_activation")
}

/// Global transit snapshots, one row per date range (reading engine M3).
model TransitSnapshot {
  id               String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  from_date        DateTime @map("from_date") @db.Date
  to_date          DateTime @map("to_date") @db.Date
  /// null = global snapshot; set = transit chart placed against this kundli's natal chart
  kundli_id        String?  @map("kundli_id")
  kundli           Kundli?  @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ayanamsa         String   @default("LAHIRI")
  snapshot_version Int      @map("snapshot_version")
  snapshot         Json
  built_at         DateTime @default(now()) @map("built_at") @db.Timestamptz(6)

  @@index([from_date, to_date], map: "transit_snapshots_range")
  @@index([kundli_id, from_date, to_date], map: "transit_snapshots_kundli_range")
  @@map("transit_snapshots")
}

/// Transit ephemeris cache (migration 20261031100000, docs/reading-engine/35): the sky at an instant for a place,
/// shared by every kundli. Payload has no natal fields.
model TransitInstant {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  place_key    String   @map("place_key")
  lat          Float
  lon          Float
  tz           Float
  at_utc       DateTime @map("at_utc") @db.Timestamptz(6)
  factors_key  String   @map("factors_key")
  ayanamsa     String   @default("LAHIRI")
  calc_version String?  @map("calc_version")
  source_hash  String   @map("source_hash")
  payload      Json
  fetched_at   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([place_key, at_utc, factors_key, ayanamsa], map: "transit_instants_key")
  @@index([at_utc], map: "transit_instants_at")
  @@map("transit_instants")
}

/// A transit_range over a span for a place, shared by every kundli. Payload has no natal block.
model TransitRangeSky {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  place_key    String   @map("place_key")
  lat          Float
  lon          Float
  tz           Float
  from_date    DateTime @map("from_date") @db.Date
  to_date      DateTime @map("to_date") @db.Date
  planets_key  String   @map("planets_key")
  flags_key    String   @map("flags_key")
  ayanamsa     String   @default("LAHIRI")
  calc_version String?  @map("calc_version")
  source_hash  String   @map("source_hash")
  payload      Json
  fetched_at   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([place_key, from_date, to_date, planets_key, flags_key, ayanamsa], map: "transit_range_skies_key")
  @@map("transit_range_skies")
}

/// A kundli's own range / contacts answer from Radha, with Radha's house fields. Houses are never derived in Node.
model KundliTransitOverlay {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id    String   @map("kundli_id")
  kundli       Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind         String
  params_key   String   @map("params_key")
  from_date    DateTime @map("from_date") @db.Date
  to_date      DateTime @map("to_date") @db.Date
  calc_version String?  @map("calc_version")
  source_hash  String   @map("source_hash")
  payload      Json
  fetched_at   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([kundli_id, kind, params_key], map: "kundli_transit_overlays_key")
  @@map("kundli_transit_overlays")
}

/// Shared day table (docs/reading-engine/47): one engine `muhurta` day per (place, date), no person in it.
model DayTable {
  id               String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  place_key        String   @map("place_key")
  place_name       String?  @map("place_name")
  lat              Float
  lon              Float
  tz_name          String   @map("tz_name")
  date             DateTime @db.Date
  utc_offset_hours Float    @map("utc_offset_hours")
  ayanamsa         String   @default("LAHIRI")
  calc_version     String?  @map("calc_version")
  engine_commit    String?  @map("engine_commit")
  source_hash      String   @map("source_hash")
  payload          Json
  fetched_at       DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([place_key, date, ayanamsa], map: "day_tables_key")
  @@index([date], map: "day_tables_date")
  @@map("day_tables")
}

/// A kundli's own day facts for a month at a place (tara, chandra bala, grade, the Moon's natal house), as the engine returned them.
model KundliDayOverlay {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id    String   @map("kundli_id")
  kundli       Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  place_key    String   @map("place_key")
  month        DateTime @db.Date
  calc_version String?  @map("calc_version")
  source_hash  String   @map("source_hash")
  payload      Json
  fetched_at   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([kundli_id, place_key, month], map: "kundli_day_overlays_key")
  @@map("kundli_day_overlays")
}

/// One row per reading (reading engine M4): intent, pack hashes, findings, timings, usage, cache.
model ReadingRun {
  id                  String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id             String    @map("user_id")
  chat_id             String?   @map("chat_id")
  message_id          String?   @unique @map("message_id")
  status              String
  question            String
  intent              Json?
  intent_confirmed    Json?     @map("intent_confirmed")
  facts_version       Int?      @map("facts_version")
  dossier_hash        String?   @map("dossier_hash")
  transit_snapshot_id String?   @map("transit_snapshot_id")
  pack_hashes         Json?     @map("pack_hashes")
  findings            Json?
  windows             Json?
  agreement           Json?
  answer              String?
  /// Gemini thought summaries for the answer call (migration 20261026100000), kept to study the reasoning.
  thinking            String?
  models              Json?
  usage               Json?
  cost_usd            Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  timings_ms          Json?     @map("timings_ms")
  cache               Json?
  dropped_claims      Int?      @map("dropped_claims")
  grounding           Json?
  errors              Json?
  prompt_version      String    @map("prompt_version")
  created_at          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completed_at        DateTime? @map("completed_at") @db.Timestamptz(6)
  user                Auth      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat                Chat?     @relation(fields: [chat_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  message             Message?  @relation(fields: [message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "reading_runs_user_created")
  @@index([chat_id], map: "reading_runs_chat")
  @@map("reading_runs")
}

/// Topics the app does not discuss (docs/reading-engine/18-declined-topics.md). category: deny | decline | role_gated.
/// The code keeps a built-in floor (src/reading/policy/declined.ts); deny topics cannot be disabled from here.
model DeclinedTopic {
  id            String   @id
  category      String
  label         String
  reply         String
  phrases       Json     @default("[]")
  words         Json     @default("[]")
  allowed_roles String[] @default([]) @map("allowed_roles")
  enabled       Boolean  @default(true)
  sort_order    Int      @default(500) @map("sort_order")
  notes         String?
  updated_at    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updated_by    String?  @map("updated_by")

  @@map("declined_topics")
}

/// Registry of explicit LLM prompt caches (docs/reading-engine/20 §8, R-7). One live row per cache: every instance looks
/// here before creating one (one cache per chart prefix), logout deletes the user's rows' caches, and the sweeper deletes
/// idle ones and reconciles against the provider's list. No foreign keys: rows are short-lived bookkeeping.
model LlmCacheEntry {
  name         String    @id
  provider     String
  user_id      String?   @map("user_id")
  kundli_id    String?   @map("kundli_id")
  prefix_hash  String    @map("prefix_hash")
  model        String
  created_at   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  last_used_at DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expires_at   DateTime  @map("expires_at") @db.Timestamptz(6)
  deleted_at   DateTime? @map("deleted_at") @db.Timestamptz(6)
  delete_error String?   @map("delete_error")

  @@index([prefix_hash, expires_at], map: "llm_cache_entries_prefix")
  @@index([user_id], map: "llm_cache_entries_user")
  @@index([last_used_at], map: "llm_cache_entries_last_used")
  @@map("llm_cache_entries")
}

/// Where the person lives now (reading engine M13, migration 20261026130000): the place as typed and the browser's IANA
/// timezone, for stating timing in local terms. lat/lon stay null (no geocoding). No relation on purpose: the server
/// reads it with raw SQL and treats a missing table as "no location" (src/services/userLocation.ts).
model UserCurrentLocation {
  user_id    String   @id @map("user_id")
  place      String
  tz         String?
  lat        Float?
  lon        Float?
  updated_at DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_current_location")
}

/// One cast prashna per question (reading engine M14, migration 20261026170000, docs/reading-engine/27 §4). Coordinates
/// rounded to two decimals; null when only the birth place text was sent. place_source: current | birth.
/// reading_run_id has no relation on purpose (the cast can precede its reading_runs row). Written by
/// src/reading/chartData/prashna.ts with raw SQL, which tolerates the table missing.
model PrashnaCast {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id        String   @map("user_id")
  reading_run_id String?  @map("reading_run_id")
  asked_at       DateTime @map("asked_at") @db.Timestamptz(6)
  place_resolved String?  @map("place_resolved")
  lat            Float?
  lon            Float?
  tz             Float?
  place_source   String   @map("place_source")
  calc_version   String?  @map("calc_version")
  payload        Json
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, asked_at], map: "prashna_casts_user_asked")
  @@map("prashna_casts")
}

/// The life-timeline ledger (docs/reading-engine/27 §B.2, migration 20261027100000): real dated life events, facts only.
/// category is dotted from the marker table (job.start, residence.move …); date_precision: day | month | year;
/// source: user | import. No relations on purpose: read with raw SQL by src/reading/timeline/store.ts, which treats a
/// missing table as "no ledger".
model LifeEvent {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id        String   @map("user_id")
  kundli_id      String   @map("kundli_id")
  category       String
  date           DateTime @db.Date
  date_precision String   @default("day") @map("date_precision")
  place          String?
  attributes     Json     @default("{}")
  source         String   @default("user")
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kundli_id, date], map: "life_events_kundli_date")
  @@index([user_id], map: "life_events_user")
  @@map("life_events")
}

/// One life-timeline build per kundli (doc 27 §B.2). status: building | ready | failed; grain: month | week | day.
model TimelineBuild {
  id              String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id       String   @map("kundli_id")
  dossier_hash    String?  @map("dossier_hash")
  from            DateTime @db.Date
  to              DateTime @db.Date
  grain           String   @default("month")
  system_versions Json     @default("{}") @map("system_versions")
  weights         Json     @default("{}")
  status          String   @default("building")
  cost_usd        Float    @default(0) @map("cost_usd")
  created_at      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kundli_id, created_at], map: "timeline_builds_kundli_created")
  @@map("timeline_builds")
}

/// The timeline grid (doc 27 §B.2): one row per non-quiet marker window; band high | moderate | possible, testing marks
/// an adverse window. how/form/prompt_version stay null until P3.
model TimelineWindow {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  build_id       String   @map("build_id")
  marker         String
  from           DateTime @db.Date
  to             DateTime @db.Date
  grain          String   @default("month")
  band           String
  testing        Boolean  @default(false)
  support_score  Float    @default(0) @map("support_score")
  test_score     Float    @default(0) @map("test_score")
  systems        Json     @default("{}")
  agent          String?
  channel        String?
  how            String?
  form           Json?
  prompt_version String?  @map("prompt_version")

  @@index([build_id, marker, from], map: "timeline_windows_build_marker")
  @@map("timeline_windows")
}

/// A ledger event matched against a build (doc 27 §A.7): result hit | near | miss.
model TimelineMatch {
  id        String  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  build_id  String  @map("build_id")
  event_id  String  @map("event_id")
  window_id String? @map("window_id")
  result    String
  specifics Json    @default("{}")

  @@index([build_id], map: "timeline_matches_build")
  @@map("timeline_matches")
}

/// Per-kundli calibration of the timing systems (doc 27 §A.7): one current row per (kundli, system, marker).
model TimelineCalibration {
  kundli_id   String   @map("kundli_id")
  system      String
  marker      String
  precision   Float?
  recall      Float?
  n           Int      @default(0)
  weight      Float
  computed_at DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@id([kundli_id, system, marker])
  @@map("timeline_calibration")
}

/// One agent response per question (docs/reading-engine/39). Written after the Oracle and validator, never the chart tables.
model ReadingAgentResponse {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  run_id         String   @map("run_id")
  user_id        String   @map("user_id")
  chat_id        String?  @map("chat_id")
  message_id     String?  @map("message_id")
  question       String
  agent          String
  agent_kind     String   @map("agent_kind")
  round          Int      @default(1)
  subject        String?
  tier           Int?
  model          String?
  prompt_name    String?  @map("prompt_name")
  prompt_version String   @map("prompt_version")
  prompt_sent    String?  @map("prompt_sent")
  data_keys      Json     @default("[]") @map("data_keys")
  data_hash      String?  @map("data_hash")
  digest         Json     @default("{}")
  highlights     Json     @default("{}")
  status         String
  failure_reason String?  @map("failure_reason")
  source         String   @default("live")
  prompt_tokens  Int      @default(0) @map("prompt_tokens")
  cached_tokens  Int      @default(0) @map("cached_tokens")
  output_tokens  Int      @default(0) @map("output_tokens")
  thought_tokens Int      @default(0) @map("thought_tokens")
  cost_usd       Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  ms             Int      @default(0)
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id], map: "reading_agent_responses_run")
  @@index([user_id, created_at(sort: Desc)], map: "reading_agent_responses_user_created")
  @@map("reading_agent_responses")
}

/// One query's metrics (docs/reading-engine/41, M19). Written when the query starts, closed when it ends, so status
/// 'processing' shows what is in flight. run_id equals reading_runs.id for kind 'reading'.
model ReadingTrace {
  run_id         String             @id @map("run_id")
  user_id        String             @map("user_id")
  /// reading | clarify | prewarm
  kind           String
  flow           String?
  /// Null for clarify and prewarm: declined topics are decided inside the clarifier.
  question       String?
  clarify_run_id String?            @map("clarify_run_id")
  /// processing | done | failed | unavailable
  status         String
  agents_spawned Int                @default(0) @map("agents_spawned")
  agents_failed  Int                @default(0) @map("agents_failed")
  model_calls    Int                @default(0) @map("model_calls")
  prompt_tokens  Int                @default(0) @map("prompt_tokens")
  cached_tokens  Int                @default(0) @map("cached_tokens")
  output_tokens  Int                @default(0) @map("output_tokens")
  thought_tokens Int                @default(0) @map("thought_tokens")
  est_cost_usd   Decimal            @default(0) @map("est_cost_usd") @db.Decimal(10, 6)
  /// Model calls in est_cost_usd's total with no price: when above 0 the estimate is low.
  unpriced_calls Int                @default(0) @map("unpriced_calls")
  ttft_ms        Int?               @map("ttft_ms")
  ms             Int?
  error          String?
  /// M24 technique labels: bucket (buckets/taxonomy.ts), template (T1..T10), tier (oracle readers), route (plan B), subjects.
  bucket         String?
  template       String?
  tier           Int?
  route          String?
  subjects       Int?
  /// M31: the catalogue technique ids the clarify context selected for this query (docs/reading-engine/53 §4.3)
  techniques      Json?
  /// M35 (docs/admin/06): deterministic Clarify Monitor evaluation for this reading
  clarify_monitor Json?             @map("clarify_monitor")
  /// M35 (docs/admin/06): tables written during this query ({ table, count })
  tables_written  Json?             @map("tables_written")
  started_at      DateTime          @map("started_at") @db.Timestamptz(6)
  ended_at       DateTime?          @map("ended_at") @db.Timestamptz(6)
  user           Auth               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spans          ReadingAgentSpan[]

  @@index([started_at(sort: Desc)], map: "reading_traces_started")
  @@index([status, started_at(sort: Desc)], map: "reading_traces_status_started")
  @@index([user_id, started_at(sort: Desc)], map: "reading_traces_user_started")
  @@index([clarify_run_id], map: "reading_traces_clarify")
  @@index([flow, started_at(sort: Desc)], map: "reading_traces_flow_started")
  @@index([bucket, started_at(sort: Desc)], map: "reading_traces_bucket_started")
  @@map("reading_traces")
}

/// One agent or one model call inside a query. Times, tokens and estimated cost only: never prompt or model text.
model ReadingAgentSpan {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  run_id         String       @map("run_id")
  agent          String
  /// reader | specialist | oracle | validator | intake | clarify | step
  agent_kind     String       @map("agent_kind")
  /// stage (the agent start to finish) | model_call (one request to a model)
  level          String
  model          String?
  /// ok | cached | failed | skipped | unfinished
  status         String
  failure_reason String?      @map("failure_reason")
  started_at     DateTime     @map("started_at") @db.Timestamptz(6)
  ended_at       DateTime     @map("ended_at") @db.Timestamptz(6)
  ms             Int
  ttft_ms        Int?         @map("ttft_ms")
  /// Steps inside a model call, in ms: wait_ms (until the response starts), read_ms (reading it)
  steps          Json?
  prompt_tokens  Int          @default(0) @map("prompt_tokens")
  cached_tokens  Int          @default(0) @map("cached_tokens")
  output_tokens  Int          @default(0) @map("output_tokens")
  thought_tokens Int          @default(0) @map("thought_tokens")
  /// Null when the model has no price, so an unpriced call never reads as free.
  est_cost_usd   Decimal?     @map("est_cost_usd") @db.Decimal(10, 6)
  /// M24: the subject a graph analyst ran for, and the oracle reader's tier.
  subject        String?
  tier           Int?
  /// M29 (docs/admin/03): the registry id (agent_registry.id), the catalogue technique and the category (self|love|work|general)
  agent_id       String?      @map("agent_id")
  technique_id   String?      @map("technique_id")
  category       String?
  run            ReadingTrace @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, started_at], map: "reading_agent_spans_run")
  @@index([agent, level, started_at(sort: Desc)], map: "reading_agent_spans_agent")
  @@index([agent_kind, level, started_at(sort: Desc)], map: "reading_agent_spans_kind")
  @@index([started_at(sort: Desc)], map: "reading_agent_spans_started")
  @@index([technique_id, started_at(sort: Desc)], map: "reading_agent_spans_technique")
  @@index([agent_id, level, started_at(sort: Desc)], map: "reading_agent_spans_agent_id")
  @@map("reading_agent_spans")
}

/// Who may ask what (docs/billing/README.md). is_paid and paid_* are written only by the payment side.
model BillingAccount {
  user_id                   String    @id
  desired_plan              String    @default("free")
  desired_interval          String?
  desired_at                DateTime? @db.Timestamptz(6)
  is_paid                   Boolean   @default(false)
  paid_plan                 String?
  paid_interval             String?
  paid_since                DateTime? @db.Timestamptz(6)
  paid_until                DateTime? @db.Timestamptz(6)
  payment_ref               String?
  billing_country           String?
  /// The most questions this account may ask in a month; null is unlimited. Stamped from env when the plan changes.
  question_quota            Int?
  questions_used_this_month Int       @default(0)
  /// The month questions_used_this_month belongs to; a new month starts it again.
  usage_month_start         DateTime? @db.Timestamptz(6)
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                      Auth      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("billing_accounts")
}

/// One row per charged question: reserved, then committed or released.
model QuestionUsage {
  id           String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id      String
  key          String
  period_start DateTime  @db.Timestamptz(6)
  /// reserved | committed | released
  status       String    @default("reserved")
  /// Later parts of a multi-part question, which are not charged again.
  open_parts   String[]  @default([])
  chat_id      String?
  message_id   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  settled_at   DateTime? @db.Timestamptz(6)
  user         Auth      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, key], map: "question_usage_user_key")
  @@index([user_id, status, created_at], map: "question_usage_user_status")
  @@map("question_usage")
}

/// The site's visit log: one row per visit id per day (docs/security/assistant-log-controls.md).
model AssistantVisit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visit_id      String
  day           DateTime @db.Date
  first_seen_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime @default(now()) @db.Timestamptz(6)
  ip_prefix     String?
  ip_full       String?
  user_agent    String?
  country       String?
  language      String?
  referrer      String?
  landing_path  String?
  legal_hold    Boolean  @default(false)

  @@unique([visit_id, day], map: "assistant_visits_visit_day")
  @@index([ip_prefix, day], map: "assistant_visits_ip_prefix_day")
  @@index([first_seen_at], map: "assistant_visits_first_seen")
  @@map("assistant_visits")
}

/// What people asked the public assistant and what it said.
model AssistantQuestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visit_id   String
  asked_at   DateTime @default(now()) @db.Timestamptz(6)
  ip         String?
  question   String
  answer     String
  verdict    String
  outcome    String
  model      String?
  tokens_in  Int?
  tokens_out Int?
  latency_ms Int?
  legal_hold Boolean  @default(false)

  @@index([asked_at], map: "assistant_questions_asked_at")
  @@index([visit_id, asked_at], map: "assistant_questions_visit_asked")
  @@map("assistant_questions")
}

/// One row per admin write (M23, docs/admin/01 §4.1.7). before/after hold plan, quota, role and lock columns only.
model AdminAction {
  id             String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  actor_user_id  String?       @map("actor_user_id")
  /// admin | cli | system
  actor_kind     String        @default("admin") @map("actor_kind")
  action         String
  target_user_id String?       @map("target_user_id")
  reason         String?
  before         Json?
  after          Json?
  ip             String?
  created_at     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// M25: the staff account that acted (admin_accounts), for writes from the admin app.
  actor_admin_id String?       @map("actor_admin_id")
  actor          Auth?         @relation("AdminActionActor", fields: [actor_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "admin_actions_actor_fkey")
  target         Auth?         @relation("AdminActionTarget", fields: [target_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "admin_actions_target_fkey")
  actor_admin    AdminAccount? @relation(fields: [actor_admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "admin_actions_actor_admin_fkey")

  @@index([target_user_id, created_at(sort: Desc)], map: "admin_actions_target")
  @@index([actor_user_id, created_at(sort: Desc)], map: "admin_actions_actor")
  @@index([actor_admin_id, created_at(sort: Desc)], map: "admin_actions_actor_admin")
  @@index([action, created_at(sort: Desc)], map: "admin_actions_action_created")
  @@index([created_at(sort: Desc)], map: "admin_actions_created")
  @@map("admin_actions")
}

/// Staff accounts for the admin app (M25, aiadastra_admin). Kept apart from customer accounts in `auth`. The password is
/// only in AWS Secrets Manager (secret_name); this row holds a scrypt hash. role: admin | superadmin. The migration also
/// makes lower(username) unique, which Prisma cannot express.
model AdminAccount {
  id              String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  username        String
  display_name    String        @map("display_name")
  role            String
  password_hash   String        @map("password_hash")
  password_set_at DateTime      @default(now()) @map("password_set_at") @db.Timestamptz(6)
  secret_name     String?       @map("secret_name")
  token_version   Int           @default(1) @map("token_version")
  disabled_at     DateTime?     @map("disabled_at") @db.Timestamptz(6)
  failed_attempts Int           @default(0) @map("failed_attempts")
  locked_until    DateTime?     @map("locked_until") @db.Timestamptz(6)
  last_login_at   DateTime?     @map("last_login_at") @db.Timestamptz(6)
  last_login_ip   String?       @map("last_login_ip")
  created_at      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  actions         AdminAction[]
  techniqueReviews TechniqueReview[]

  @@map("admin_accounts")
}

/// Lucky times v1 (docs/reading-engine/49): the person's place for day tables, set once.
model LuckyPref {
  user_id    String   @id @map("user_id")
  place_key  String   @map("place_key")
  updated_at DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lucky_prefs_user_fkey")

  @@map("lucky_prefs")
}

/// A scenario the person added on Lucky times, whether its calendar layer is shown, and the one-tap answers.
model LuckyScenarioPick {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id     String   @map("user_id")
  scenario_id String   @map("scenario_id")
  shown       Boolean  @default(true)
  answers     Json     @default("{}")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lucky_scenario_picks_user_fkey")

  @@unique([user_id, scenario_id], map: "lucky_scenario_picks_key")
  @@map("lucky_scenario_picks")
}

/// One row per agent (docs/reading-engine/49 §4.1): what it does, where it belongs, which model and what that costs.
model AgentRegistry {
  id            String     @id
  title         String
  /// engine_pull | code | llm
  kind          String
  module        String
  sub_module    String?    @map("sub_module")
  provider      String?
  model         String?
  /// USD per 1M tokens
  price_in      Decimal?   @map("price_in") @db.Decimal(12, 6)
  price_out     Decimal?   @map("price_out") @db.Decimal(12, 6)
  price_cached  Decimal?   @map("price_cached") @db.Decimal(12, 6)
  price_version String?    @map("price_version")
  description   String?
  enabled       Boolean    @default(true)
  updated_at    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  runs          AgentRun[]

  @@map("agent_registry")
}

/// One row per agent run: who it ran for, the task, timings, tokens and estimated cost.
model AgentRun {
  id             String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  agent_id       String        @map("agent_id")
  user_id        String?       @map("user_id")
  module         String
  sub_module     String?       @map("sub_module")
  task           String
  /// ok | failed | cached | skipped
  status         String
  error          String?
  input_summary  Json?         @map("input_summary")
  output_summary Json?         @map("output_summary")
  model          String?
  started_at     DateTime      @map("started_at") @db.Timestamptz(6)
  ended_at       DateTime      @map("ended_at") @db.Timestamptz(6)
  ms             Int
  prompt_tokens  Int           @default(0) @map("prompt_tokens")
  cached_tokens  Int           @default(0) @map("cached_tokens")
  output_tokens  Int           @default(0) @map("output_tokens")
  thought_tokens Int           @default(0) @map("thought_tokens")
  est_cost_usd   Decimal?      @map("est_cost_usd") @db.Decimal(10, 6)
  /// M29 (docs/admin/03): the catalogue technique this run served, its category and board, and what it read
  technique_id   String?       @map("technique_id")
  category       String?
  board          String?
  kundli_id      String?       @map("kundli_id")
  subject        String?
  /// [{ type, variant?, calc_version? }]: the engine payloads the run read
  charts_used    Json?         @map("charts_used")
  agent          AgentRegistry @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agent_runs_agent_fkey")
  user           Auth?         @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "agent_runs_user_fkey")

  @@index([agent_id, started_at], map: "agent_runs_agent_started")
  @@index([started_at], map: "agent_runs_started")
  @@index([technique_id, started_at(sort: Desc)], map: "agent_runs_technique")
