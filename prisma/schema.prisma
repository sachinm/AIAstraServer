generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Auth {
  id                    String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  username              String
  password              String
  date_of_birth         String
  place_of_birth        String?
  time_of_birth         String?
  email                 String
  gender                String?
  is_active             Boolean?               @default(true)
  kundli_added          Boolean?               @default(false)
  role                  String?                @default("user")
  created_at            DateTime               @default(now()) @map("created_at")
  /// Client IP at account creation (from proxy headers when present).
  signup_ip             String?                @map("signup_ip")
  /// Bcrypt hash of the current magic-link code (plain code is only sent by email).
  magic_link_code_hash  String?                @map("magic_link_code_hash")
  magic_link_expires_at DateTime?              @map("magic_link_expires_at") @db.Timestamptz(6)
  /// AUTH_PROVIDER=cognito: the InitiateAuth Session parked between requestMagicLink and loginWithMagicLink.
  cognito_session            String?               @map("cognito_session")
  cognito_session_expires_at DateTime?             @map("cognito_session_expires_at") @db.Timestamptz(6)
  chats                 Chat[]
  readingRuns           ReadingRun[]
  prashnaCasts          PrashnaCast[]
  kundlis               Kundli[]
  userGeneratedContent  UserGeneratedContent[]

  @@map("auth")
}

model Kundli {
  id                 String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id            String
  biodata            Json?
  d1                 Json?
  d2                 Json?
  d4                 Json?
  d7                 Json?
  d9                 Json?
  d10                Json?
  charakaraka        Json?
  vimsottari_dasa    Json?                  @map("vimsottari_dasa")
  narayana_dasa      Json?                  @map("narayana_dasa")
  other_readings     Json?                  @map("other_readings")
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  queue_status       String                 @default("pending") @map("queue_status")
  queue_started_at   DateTime?              @map("queue_started_at")
  queue_completed_at DateTime?              @map("queue_completed_at")
  last_sync_error    String?                @map("last_sync_error")
  /// Coordinates stored once (reading engine M1) so nothing geocodes again.
  lat                Float?
  lon                Float?
  tz                 Float?
  place_resolved     String?                @map("place_resolved")
  /// pending | building | ready | failed
  facts_status       String                 @default("pending") @map("facts_status")
  facts              KundliFacts[]
  transitCharts      TransitSnapshot[]
  chartData          KundliData[]
  user               Auth                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content            UserGeneratedContent[]

  @@index([user_id], map: "idx_kundlis_user_id")
  @@map("kundlis")
}

model SystemPrompt {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name      String   @unique
  prompt    String
  is_active Boolean? @default(true) @map("is_active")

  @@map("system_prompts")
}

model UserGeneratedContent {
  id         String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id    String
  kundli_id  String
  remedies   Json?
  mantras    Json?
  routines   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  kundli     Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kundli_id], map: "idx_user_generated_content_kundli_id")
  @@index([user_id], map: "idx_user_generated_content_user_id")
  @@map("user_generated_content")
}

model Chat {
  id          String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id     String
  /// Short title shown in the UI: first user question, trimmed to 50 chars (set when the first message is saved).
  name        String?
  is_active   Boolean      @default(true) @map("is_active")
  created_at  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Auth         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    Message[]
  chatLogs    ChatLog[]
  readingRuns ReadingRun[]

  @@index([user_id], map: "idx_chats_user_id")
  @@map("chats")
}

model Message {
  id         String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  chat_id    String
  question   String
  ai_answer  String      @map("ai_answer")
  created_at DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  chat       Chat        @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chatLog    ChatLog?
  readingRun ReadingRun?

  @@index([chat_id], map: "idx_messages_chat_id")
  @@map("messages")
}

model ChatLog {
  id                  String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  chat_id             String   @map("chat_id")
  message_id          String   @unique @map("message_id")
  request_payload     Json     @map("request_payload")
  response_payload    Json     @map("response_payload")
  /// True when the answer was delivered via POST /api/chat/ask-stream (SSE). False for GraphQL `ask`.
  /// Matches the web app when VITE_CHAT_STREAM is enabled (default); not sent from the client—set by the server.
  client_delivery_sse Boolean  @default(false) @map("client_delivery_sse")
  created_at          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chat                Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message             Message  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id], map: "idx_chat_logs_chat_id")
  @@map("chat_logs")
}

/// Chart-facts dossier per kundli and facts version (reading engine M2).
model KundliFacts {
  id            String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id     String   @map("kundli_id")
  facts_version Int      @map("facts_version")
  engine_commit String   @map("engine_commit")
  ayanamsa      String   @default("LAHIRI")
  dossier       Json
  natal_points  Json     @map("natal_points")
  dossier_hash  String   @map("dossier_hash")
  /// Hash of the legacy kundli columns the dossier was built from; a change triggers a rebuild.
  source_hash   String   @map("source_hash")
  built_at      DateTime @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli        Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kundli_id, facts_version], map: "kundli_facts_kundli_version")
  @@map("kundli_facts")
}

/// The keyword list of chart data types Radha can serve (reading engine M7, docs/reading-engine/20 §4). Seeded from
/// src/reading/chartData/catalog.ts; rows override served/tier/calc_version/enabled.
model ChartDataType {
  id            String       @id
  family        String
  radha_type    String       @map("radha_type")
  change_class  String       @map("change_class")
  tier          String
  variant_kind  String       @map("variant_kind")
  served        Boolean      @default(false)
  calc_version  String?      @map("calc_version")
  legacy_column String?      @map("legacy_column")
  sort_order    Int          @default(500) @map("sort_order")
  label         String
  enabled       Boolean      @default(true)
  updated_at    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  rows          KundliData[]

  @@map("chart_data_types")
}

/// One row per (kundli, chart data type, variant): the vertical kundli store (reading engine M7).
/// The row is also the fetch lock: status 'fetching' + fetch_started_at, reclaimable after the Radha timeout.
model KundliData {
  id               String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id        String        @map("kundli_id")
  data_type        String        @map("data_type")
  /// '' for natal rows; canonical key of params (e.g. 'year=2027') otherwise
  variant          String        @default("")
  params           Json          @default("{}")
  ayanamsa         String        @default("LAHIRI")
  calc_version     String?       @map("calc_version")
  engine_commit    String?       @map("engine_commit")
  payload          Json?
  payload_hash     String?       @map("payload_hash")
  /// ready | fetching | failed | unsupported
  status           String        @default("fetching")
  error            String?
  fetch_started_at DateTime?     @map("fetch_started_at") @db.Timestamptz(6)
  fetched_at       DateTime?     @map("fetched_at") @db.Timestamptz(6)
  valid_to         DateTime?     @map("valid_to") @db.Timestamptz(6)
  kundli           Kundli        @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type             ChartDataType @relation(fields: [data_type], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([kundli_id, data_type, variant, ayanamsa], name: "kundli_data_key", map: "kundli_data_key")
  @@index([data_type, status], map: "idx_kundli_data_type_status")
  @@map("kundli_data")
}

/// Global transit snapshots, one row per date range (reading engine M3).
model TransitSnapshot {
  id               String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  from_date        DateTime @map("from_date") @db.Date
  to_date          DateTime @map("to_date") @db.Date
  /// null = global snapshot; set = transit chart placed against this kundli's natal chart
  kundli_id        String?  @map("kundli_id")
  kundli           Kundli?  @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ayanamsa         String   @default("LAHIRI")
  snapshot_version Int      @map("snapshot_version")
  snapshot         Json
  built_at         DateTime @default(now()) @map("built_at") @db.Timestamptz(6)

  @@index([from_date, to_date], map: "transit_snapshots_range")
  @@index([kundli_id, from_date, to_date], map: "transit_snapshots_kundli_range")
  @@map("transit_snapshots")
}

/// One row per reading (reading engine M4): intent, pack hashes, findings, timings, usage, cache.
model ReadingRun {
  id                  String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id             String    @map("user_id")
  chat_id             String?   @map("chat_id")
  message_id          String?   @unique @map("message_id")
  status              String
  question            String
  intent              Json?
  intent_confirmed    Json?     @map("intent_confirmed")
  facts_version       Int?      @map("facts_version")
  dossier_hash        String?   @map("dossier_hash")
  transit_snapshot_id String?   @map("transit_snapshot_id")
  pack_hashes         Json?     @map("pack_hashes")
  findings            Json?
  windows             Json?
  agreement           Json?
  answer              String?
  /// Gemini thought summaries for the answer call (migration 20261026100000), kept to study the reasoning.
  thinking            String?
  models              Json?
  usage               Json?
  cost_usd            Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  timings_ms          Json?     @map("timings_ms")
  cache               Json?
  dropped_claims      Int?      @map("dropped_claims")
  grounding           Json?
  errors              Json?
  prompt_version      String    @map("prompt_version")
  created_at          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completed_at        DateTime? @map("completed_at") @db.Timestamptz(6)
  user                Auth      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat                Chat?     @relation(fields: [chat_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  message             Message?  @relation(fields: [message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "reading_runs_user_created")
  @@index([chat_id], map: "reading_runs_chat")
  @@map("reading_runs")
}

/// Topics the app does not discuss (docs/reading-engine/18-declined-topics.md). category: deny | decline | role_gated.
/// The code keeps a built-in floor (src/reading/policy/declined.ts); deny topics cannot be disabled from here.
model DeclinedTopic {
  id            String   @id
  category      String
  label         String
  reply         String
  phrases       Json     @default("[]")
  words         Json     @default("[]")
  allowed_roles String[] @default([]) @map("allowed_roles")
  enabled       Boolean  @default(true)
  sort_order    Int      @default(500) @map("sort_order")
  notes         String?
  updated_at    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updated_by    String?  @map("updated_by")

  @@map("declined_topics")
}

/// Registry of explicit LLM prompt caches (docs/reading-engine/20 §8, R-7). One live row per cache: every instance looks
/// here before creating one (one cache per chart prefix), logout deletes the user's rows' caches, and the sweeper deletes
/// idle ones and reconciles against the provider's list. No foreign keys: rows are short-lived bookkeeping.
model LlmCacheEntry {
  name         String    @id
  provider     String
  user_id      String?   @map("user_id")
  kundli_id    String?   @map("kundli_id")
  prefix_hash  String    @map("prefix_hash")
  model        String
  created_at   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  last_used_at DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expires_at   DateTime  @map("expires_at") @db.Timestamptz(6)
  deleted_at   DateTime? @map("deleted_at") @db.Timestamptz(6)
  delete_error String?   @map("delete_error")

  @@index([prefix_hash, expires_at], map: "llm_cache_entries_prefix")
  @@index([user_id], map: "llm_cache_entries_user")
  @@index([last_used_at], map: "llm_cache_entries_last_used")
  @@map("llm_cache_entries")
}

/// Where the person lives now (reading engine M13, migration 20261026130000): the place as typed and the browser's IANA
/// timezone, for stating timing in local terms. lat/lon stay null (no geocoding). No relation on purpose: the server
/// reads it with raw SQL and treats a missing table as "no location" (src/services/userLocation.ts).
model UserCurrentLocation {
  user_id    String   @id @map("user_id")
  place      String
  tz         String?
  lat        Float?
  lon        Float?
  updated_at DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_current_location")
}

/// One cast prashna per question (reading engine M14, migration 20261026170000, docs/reading-engine/27 §4). Coordinates
/// rounded to two decimals; null when only the birth place text was sent. place_source: current | birth.
/// reading_run_id has no relation on purpose (the cast can precede its reading_runs row). Written by
/// src/reading/chartData/prashna.ts with raw SQL, which tolerates the table missing.
model PrashnaCast {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id        String   @map("user_id")
  reading_run_id String?  @map("reading_run_id")
  asked_at       DateTime @map("asked_at") @db.Timestamptz(6)
  place_resolved String?  @map("place_resolved")
  lat            Float?
  lon            Float?
  tz             Float?
  place_source   String   @map("place_source")
  calc_version   String?  @map("calc_version")
  payload        Json
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, asked_at], map: "prashna_casts_user_asked")
  @@map("prashna_casts")
}