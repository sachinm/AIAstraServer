/// M37 (docs/reading-engine/56 §4.1): digested technique output stored by its validity date range [valid_from, valid_to)
/// so a second request inside the window returns the stored output and skips running the agent.
model TechniqueOutput {
  cache_key      String    @id @map("cache_key")
  technique_id   String    @map("technique_id")
  kundli_id      String    @map("kundli_id")
  digest_version String    @map("digest_version")
  /// natal | annual | dasha | daily | transit
  freshness      String
  valid_from     DateTime  @map("valid_from") @db.Timestamptz(6)
  valid_to       DateTime? @map("valid_to") @db.Timestamptz(6)
  output         Json
  output_schema  String    @map("output_schema")
  made_by_agent  String?   @map("made_by_agent")
  made_ms        Int       @default(0) @map("made_ms")
  created_at     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  hit_count      Int       @default(0) @map("hit_count")
  last_hit_at    DateTime? @map("last_hit_at") @db.Timestamptz(6)
  kundli         Kundli    @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "technique_outputs_kundli_fkey")

  @@index([kundli_id, technique_id], map: "idx_technique_outputs_kundli_technique")
  /// newest-first walk for the board reads (findFirst ... orderBy created_at desc); stops at the first match
  @@index([kundli_id, technique_id, created_at(sort: Desc)], map: "idx_technique_outputs_kundli_technique_created")
  @@index([kundli_id, hit_count, last_hit_at, created_at], map: "idx_technique_outputs_recycle")
  @@index([valid_to], map: "idx_technique_outputs_valid_to")
  @@map("technique_outputs")
}

/// M37 (docs/admin/08): Per-request and per-page execution timing log across server routes, GraphQL operations,
/// SSE streams and browser page renders/draws. Holds timings, status codes, byte counts and safe route labels only — never PII.
model PageExecutionLog {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  page         String   @db.VarChar(120)
  /// server_request | graphql | sse_stream | client_render | section_stream
  source       String   @db.VarChar(32)
  /// GET | POST | PUT | PATCH | DELETE | GRAPHQL | SSE | RENDER
  method       String   @db.VarChar(16)
  /// Normalized route or operation (e.g. 'Query.me', 'Query.myBiodata', '/api/area/career', 'client:page_load')
  operation    String   @db.VarChar(160)
  status_code  Int      @default(200) @map("status_code")
  duration_ms  Int      @map("duration_ms")
  ttfb_ms      Int?     @map("ttfb_ms")
  server_ms    Int?     @map("server_ms")
  db_ms        Int?     @map("db_ms")
  render_ms    Int?     @map("render_ms")
  draw_ms      Int?     @map("draw_ms")
  body_bytes   Int?     @map("body_bytes")
  /// hit | miss | partial | bypass | null
  cache_status String?  @map("cache_status") @db.VarChar(24)
  user_id      String?  @map("user_id")
  session_id   String?  @map("session_id") @db.VarChar(64)
  request_id   String?  @map("request_id") @db.VarChar(64)
  error_code   String?  @map("error_code") @db.VarChar(80)
  meta         Json     @default("{}")
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([page, created_at(sort: Desc)], map: "page_execution_logs_page_created_idx")
  @@index([created_at(sort: Desc)], map: "page_execution_logs_created_idx")
  @@index([source, created_at(sort: Desc)], map: "page_execution_logs_source_created_idx")
  @@index([user_id, created_at(sort: Desc)], map: "page_execution_logs_user_created_idx")
  @@index([duration_ms(sort: Desc)], map: "page_execution_logs_duration_idx")
  @@map("page_execution_logs")
}

