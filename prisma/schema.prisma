/// Every selfie capture sent to the server, for the rate limit (5 an hour, 20 a day).
model ProfilePhotoAttempt {
  id      String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id String   @map("user_id")
  /// ok | too_big | not_jpeg | bad_image | bad_size | no_face
  outcome String
  at      DateTime @default(now()) @db.Timestamptz(6)
  user    Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_photo_attempts_user_fkey")

  @@index([user_id, at], map: "profile_photo_attempts_user_at")
  @@map("profile_photo_attempts")
}

/// M29 (docs/admin/03 §4.1): the technique catalogue (src/techniques/catalog.ts), upserted at boot. The admin reads it.
model TechniqueRegistry {
  id         String   @id
  title      String
  /// self | love | work | general
  category   String
  /// you | love | work | lucky | chat
  board      String
  /// built | partial | planned
  status     String
  charts     Json     @default("[]")
  algorithm  Json     @default("[]")
  special    String?
  source     String?
  code_ref   String?  @map("code_ref")
  agents     Json     @default("[]")
  accuracy   String?
  updated_at DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([category, board], map: "technique_registry_category")
  @@map("technique_registry")
}

/// M29: a staff verdict on one run (an agent_runs or a reading_agent_spans row). Written only by the admin API.
model TechniqueReview {
  id           String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  /// agent_run | span
  run_kind     String       @map("run_kind")
  run_id       String       @map("run_id")
  technique_id String?      @map("technique_id")
  /// right | wrong | unsure
  verdict      String
  /// 500 characters or less
  note         String?
  admin_id     String       @map("admin_id")
  created_at   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  admin        AdminAccount @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "technique_reviews_admin_id_fkey")

  @@index([run_kind, run_id], map: "technique_reviews_run")
  @@index([technique_id, created_at(sort: Desc)], map: "technique_reviews_technique")
  @@map("technique_reviews")
}

/// What a person changes about their account, from which IP and user agent, and when (docs/admin/02). Not clicks
/// (analytics_events) and not staff writes (admin_actions). No relation: the record outlives the account.
model AccountEvent {
  id              String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id         String?
  /// self | staff | payment_gateway | system
  actor           String   @default("self")
  action          String
  /// ok | refused | failed
  outcome         String   @default("ok")
  /// names of what changed, never values
  fields          Json     @default("[]")
  before          Json?
  after           Json?
  note            String?
  ip              String?
  ip_chain        String?
  user_agent      String?
  accept_language String?
  country         String?
  request_id      String?
  path            String?
  method          String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "account_events_user")
  @@index([action, created_at(sort: Desc)], map: "account_events_action")
  @@index([ip, created_at(sort: Desc)], map: "account_events_ip")
  @@map("account_events")
}

/// M30 (docs/admin/04): one row per signed-in user per local day (REPORT_TZ, default America/Los_Angeles), upserted on
/// the same tick that writes auth.last_seen_at (at most every 5 minutes per user per instance). History for the admin's
/// daily and weekly active users.
model UserActivityDay {
  user_id       String   @map("user_id")
  day           DateTime @db.Date
  first_seen_at DateTime @map("first_seen_at") @db.Timestamptz(6)
  last_seen_at  DateTime @map("last_seen_at") @db.Timestamptz(6)
  /// 5-minute ticks with a request
  touches       Int      @default(1)
  user          Auth     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_activity_days_user_id_fkey")

  @@id([user_id, day])
  @@index([day], map: "user_activity_days_day")
  @@map("user_activity_days")
}
