  sources            Json           @default("[]")
  calc_version       String         @default("1") @map("calc_version") @db.VarChar(24)
  built_at           DateTime       @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli             ResearchKundli @relation(fields: [research_kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "research_digests_kundli_fkey")

  @@unique([research_kundli_id, section, item_key], map: "research_digests_kundli_sec_key")
  @@index([research_kundli_id, section], map: "research_digests_kundli_sec_idx")
  @@map("research_digests")
}

/// M38 (docs/admin/09): Staging copy of `kundli_activation` multi-system dasha periods for synthetic research kundlis.
model ResearchActivation {
  id                 BigInt         @id @default(autoincrement())
  research_kundli_id String         @map("research_kundli_id")
  system             String         @db.VarChar(32)
  level              Int            @db.SmallInt
  lord               String         @db.VarChar(24)
  path               String         @db.VarChar(80)
  start_date         DateTime       @map("start_date") @db.Date
  end_date           DateTime       @map("end_date") @db.Date
  houses             Int[]          @db.SmallInt
  planet_factors     Json           @default("{}") @map("planet_factors")
  built_at           DateTime       @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli             ResearchKundli @relation(fields: [research_kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "research_activations_kundli_fkey")

  @@index([research_kundli_id, start_date, end_date], map: "research_activations_kundli_dates_idx")
  @@index([research_kundli_id, system, level], map: "research_activations_kundli_sys_idx")
  @@map("research_activations")
}

/// M38 (docs/admin/09): Hydrated Self Dashboard QA run with 12-house/10-varga matrix, Nov/Thanksgiving/Dec/New Year zoom-in,
/// 10-step technical trace (pulled vs excluded + classical rules), plain-English reading, and Independent Technical Verifier audit.
model ResearchDashboardRun {
  id                 String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  research_kundli_id String         @map("research_kundli_id")
  subject_code       String         @map("subject_code") @db.VarChar(80)
  /// self | love | work
  board_area         String         @default("self") @map("board_area") @db.VarChar(16)
  as_of              String         @map("as_of") @db.VarChar(16)
  tone               String         @db.VarChar(32)
  verdict_pill       String         @map("verdict_pill") @db.VarChar(64)
  charter_summary    String         @map("charter_summary")
  board_data         Json           @map("board_data")
  house_varga_matrix Json           @map("house_varga_matrix")
  temporal_data      Json           @map("temporal_data")
  trace_data         Json           @map("trace_data")
  reading_prose      Json           @map("reading_prose")
  /// pass | warn | fail
  verifier_verdict   String         @map("verifier_verdict") @db.VarChar(16)
  accuracy_score     Float          @map("accuracy_score")
  verifier_data      Json           @map("verifier_data")
  duration_ms        Int            @default(0) @map("duration_ms")
  created_at         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  kundli             ResearchKundli @relation(fields: [research_kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "research_dashboard_runs_kundli_fkey")

  @@index([research_kundli_id, created_at(sort: Desc)], map: "research_dashboard_runs_kundli_idx")
  @@index([subject_code, created_at(sort: Desc)], map: "research_dashboard_runs_subject_idx")
  @@index([verifier_verdict, accuracy_score(sort: Desc)], map: "research_dashboard_runs_verdict_idx")
  @@map("research_dashboard_runs")
}



/// Self v2 validation failures (docs/reading-engine/66 §4.1, 2026-11-09): every finding of the Oracle and Personalizer
/// validators per build, with the area's status after the one Oracle repair pass (ok | repaired | failed). Staff-only;
/// no words of the person, so not in SEALED_MODELS. Written by src/reading/self/v2/failures.ts; read by the admin loads view.
model ReadingValidationFailure {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id     String   @map("user_id")
  kundli_id   String   @map("kundli_id")
  board       String
  build_id    String   @map("build_id")
  /// oracle | personalizer
  stage       String
  /// area id, 'hero', or null for the document as a whole
  area        String?
  check       String
  message     String
  /// ok | repaired | failed (Oracle areas); null for the Personalizer
  area_status String?  @map("area_status")
  model       String
  prompt_hash String   @map("prompt_hash")
  /// oracle.a | oracle.b | oracle.c | oracle.repair | self.personalizer
  call_id     String?  @map("call_id")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  kundli      Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reading_validation_failures_kundli_fkey")

  @@index([kundli_id, board, created_at(sort: Desc)], map: "reading_validation_failures_kundli_board_created_idx")
  @@index([build_id], map: "reading_validation_failures_build_idx")
  @@map("reading_validation_failures")
}

/// The person's board layout (docs/reading-engine/68 §4.5 item 8, 69 §4.1 item 6): which cards, in what order, which
/// sections, which template. One row per kundli per board. No astrological content; changing it never calls a model.
model BoardLayout {
  id         String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  user_id    String   @map("user_id")
  kundli_id  String   @map("kundli_id")
  /// self | love | work
  board      String
  /// compact | seasons | single | table
  template   String
  /// ordered card ids
  cards      Json
  /// per card id, the sections switched on, when the person changed them
  sections   Json     @default("{}")
  /// per card id, how it reads (length, view, words, plan), when the person changed it (docs/reading-engine/71)
  options    Json     @default("{}")
  /// the board-wide settings (card option keys plus confirm and motion), when the person changed them
  board_options Json  @default("{}") @map("board_options")
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  kundli     Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "board_layout_kundli_fkey")

  @@unique([kundli_id, board], map: "board_layout_kundli_board_key")
  @@map("board_layout")
}

/// M48 (docs/reading-engine/70 §4.1 Layer 1): the stored engine rows rendered once into fixed text blocks (natal.core,
/// sky.window, year.tp, frame, clock.<system>, matter.<key>), one row per kundli per slice. A build reads slices and never
/// renders raw rows. `text` and `keys` are sealed (SEALED_MODELS); `hash` changes only when the rendered text changes.
model KundliSlice {
  id         String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  kundli_id  String   @map("kundli_id")
  slice_id   String   @map("slice_id")
  text       String
  /// evidence keys the text carries in {braces}
  keys       Json     @default("[]")
  est_tokens Int      @default(0) @map("est_tokens")
  /// the stored data the slice was rendered from: [{ dataType, variant, calcVersion, hash }]
  sources    Json     @default("[]")
  hash       String
  built_at   DateTime @default(now()) @map("built_at") @db.Timestamptz(6)
  kundli     Kundli   @relation(fields: [kundli_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "kundli_slices_kundli_fkey")

  @@unique([kundli_id, slice_id], name: "kundli_slice_key", map: "kundli_slices_kundli_slice_key")
  @@map("kundli_slices")
}
