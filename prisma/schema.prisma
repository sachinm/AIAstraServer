  target_user_id String?       @map("target_user_id")
  reason         String?
  before         Json?
  after          Json?
  ip             String?
  created_at     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// M25: the staff account that acted (admin_accounts), for writes from the admin app.
