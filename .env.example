# Database – Supabase Postgres (backend only; never expose to frontend)
# Pooler URL for Prisma Client at runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# JWT secret for session tokens (required; min 32 chars, use a long random string)
JWT_SECRET=your-jwt-secret-min-32-chars

# Supabase (optional – only if keeping any Supabase client temporarily)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Optional: PII encryption at rest (32 bytes hex or base64). If set, DOB/POB/TOB are encrypted in auth.
# ENCRYPTION_KEY=

# Superadmin – default login that is always available.
# Set SUPERADMIN_PASSWORD (min 16 chars) to enable. Run backend with npm start to create/update the account.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=AdAstra_Sup3r@dmin_#2024!Xk9
SUPERADMIN_EMAIL=superadmin@adastra.local

# Optional: OpenAI / LLM (for RAG/query)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Groq – used for chat with Vedic astrology oracle (model: openai/gpt-oss-120b)
GROQ_API_KEY=
# Optional override for Groq model id
# MODEL_ID=openai/gpt-oss-120b

# GraphQL `ask` chat backend: groq (default) or gemini
# CHAT_LLM_PROVIDER=groq
# Google Gemini (required when CHAT_LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_FLASH_MODEL_ID=gemini-2.5-flash
# Max output tokens per chat reply (256–65536; default 2048 Phase A). Raise if answers truncate.
# GEMINI_MAX_OUTPUT_TOKENS=2048
# generationConfig knobs (defaults: temperature 0.5, topP 0.9)
# GEMINI_TEMPERATURE=0.5
# GEMINI_TOP_P=0.9
# Kundli packed into chat: lean (default: biodata,d1,d9,vimsottari_dasa,charakaraka) or full
# CHAT_KUNDLI_CONTEXT=lean
# CHAT_KUNDLI_CONTEXT=full
# Undici timeouts for Gemini HTTP. Code default remains 600000 (10m) so mid-stream SSE is not cut carelessly.
# For latency SLOs you can try ~45s (45000) in non-streaming or short-reply setups — lower values can abort long streams.
# GEMINI_HTTP_TIMEOUT_MS=45000
# Optional overrides (undici headersTimeout / bodyTimeout):
# GEMINI_FETCH_HEADERS_TIMEOUT_MS=
# GEMINI_FETCH_BODY_TIMEOUT_MS=

# Transactional email — magic link sign-in (8-char code, 5 min). Use Resend and/or SMTP.
# RESEND_API_KEY=
# MAIL_FROM="AdAstra <noreply@yourdomain.com>"
# Optional subject override:
# MAGIC_LINK_EMAIL_SUBJECT=Your sign-in code
# Or SMTP (if not using Resend):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=

# Google reCAPTCHA v3 (secret key for siteverify). When set, login and signup require a valid token from the web app.
# Create keys: https://www.google.com/recaptcha/admin (v3). Frontend: VITE_RECAPTCHA_SITE_KEY (same registration).
# RECAPTCHA_SECRET_KEY=
# Optional v3 score threshold 0–1 (default 0.5). Ignored for v2 checkbox keys.
# RECAPTCHA_MIN_SCORE=0.5

# Cloudflare Turnstile secret. When set, login/signup/magic-link require turnstileToken from the web app.
# Frontend: VITE_TURNSTILE_SITE_KEY (same widget registration).
# TURNSTILE_SECRET_KEY=

# Optional: server port (default 3000)
# PORT=3000
# Authenticated chat token streaming (same JWT as GraphQL). Frontend: VITE_CHAT_STREAM (default on).
# POST /api/chat/ask-stream — proxy must not buffer SSE (nginx: proxy_buffering off; X-Accel-Buffering: off is set).
# Optional: SSE comment ping interval (ms) during long LLM wait; default 12000, clamped 5000–60000.
# CHAT_SSE_PING_MS=12000
# DB: chat_logs.client_delivery_sse — true for /api/chat/ask-stream, false for GraphQL ask (matches VITE_CHAT_STREAM when client default). See docs/chat-sse-deployment.md.

# AstroKundli / pyjhora transport: http (local/dev) or lambda (App Runner → private InvokeFunction)
# ASTROKUNDLI_TRANSPORT=http
# ASTROKUNDLI_TRANSPORT=lambda
# When lambda: App Runner task role needs lambda:InvokeFunction on the function below (no Function URL / no public resource policy).
# ASTROKUNDLI_LAMBDA_FUNCTION_NAME=aiastra-pyjhora
# ASTROKUNDLI_LAMBDA_REGION=us-east-1
# (region falls back to AWS_REGION, then us-east-1)

# HTTP base URLs (used when ASTROKUNDLI_TRANSPORT=http or unset)
# Local/dev: port 8765; Staging: 8766; Production: 8767
ASTROKUNDLI_BASE_URL_LOCAL=http://localhost:8765
ASTROKUNDLI_BASE_URL_STAGING=http://localhost:8766
ASTROKUNDLI_BASE_URL_PROD=http://localhost:8767
# Optional: API key if the 3rd party requires it (HTTP mode)
# ASTROKUNDLI_API_KEY=

# Optional: set ASTROKUNDLI_LOG_RESPONSE=1 to log API responses to kundli-queue.log (for debugging)
# ASTROKUNDLI_LOG_RESPONSE=1

# Kundli sync is event-driven (login/signup/magic-link/admin); there is no periodic setInterval tick.

# Kundli queue log file – path for queue task logs (default: logs/kundli-queue.log)
# KUNDLI_QUEUE_LOG_FILE=logs/kundli-queue.log
# Set KUNDLI_QUEUE_LOG_CONSOLE=1 to also log to stdout

# Gemini explicit context cache (DynamoDB pointers)
GEMINI_CACHE_TABLE=aiastra-gemini-cache
GEMINI_CACHE_TTL_SECONDS=604800
# GEMINI_CACHE_ENABLED=0

# ---------------------------------------------------------------------------------------------------------------
# Reading engine (docs/reading-engine). All optional. The reading engine IS the chat path by default.
# READING_ENGINE=0 is the kill switch that restores the legacy chat path.
# READING_ENGINE=1
# single = intake, evidence pack, ONE streamed call.  graph = parallel specialists, reconcile, streamed synthesis.
# READING_FLOW=single
# db = kundli_facts + per-kundli transit chart from the pyjhora Lambda.  fixture = golden chart G1 (dev and evals).
# READING_FACTS_SOURCE=db
# Emergency opt-in only: when a kundli has no dossier yet, answer on the legacy path. Default off: the engine says the
# chart is being prepared and schedules the build.
# READING_FALLBACK_LEGACY=1
# Build the dossier after kundli sync and lazily on a miss (default follows READING_ENGINE). 0 disables.
# READING_FACTS_BUILD=1
# auto = rules first, a small model only when unsure.  rules = never call a model.  llm = always call a model.
# READING_INTAKE_MODE=auto
# Model ids per role; every role defaults to GEMINI_FLASH_MODEL_ID until paid billing is confirmed.
# READING_MODEL_INTAKE=
# READING_MODEL_SPECIALIST=
# READING_MODEL_SYNTH=
# READING_MODEL_FAST=
# Final answer: thinking effort off|low|medium|high (low = 512 token budget on 2.x) and output cap.
# READING_SYNTH_THINKING=low
# READING_SYNTH_MAX_OUTPUT_TOKENS=4096
# READING_SPECIALIST_TIMEOUT_MS=12000
# Skip the specialists for one-subject yes/no and explain-term questions up to 6 months (graph flow). 0 disables.
# READING_FAST_LANE=1
# In-process cache for dossier and transit chart (warm Lambda reuse).
# READING_CACHE_TTL_MS=300000
# Engine call budget for a lazy transit chart build on a cache miss.
# READING_ENGINE_TIMEOUT_MS=8000
# Use the DB pvr_oracle persona instead of the file persona (off: a daily-changing system prompt breaks the prefix cache).
# READING_USE_DB_PERSONA=0
