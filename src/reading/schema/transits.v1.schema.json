{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiastra.local/schemas/transits.v1.schema.json",
  "title": "AI Astra per-kundli transit chart, version 1 (natal_overlay)",
  "description": "Contract for the pyjhora Lambda `transits` export served per kundli: every transit period already placed against the natal chart. Node selects rows from it; it never derives houses or overlays.",
  "type": "object",
  "required": ["v", "kind", "as_of", "from", "to", "natal", "now", "rows", "double_transit", "sade_sati"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "natal_overlay" },
    "ayanamsa": { "type": "string" },
    "as_of": { "$ref": "#/definitions/isoDate" },
    "from": { "$ref": "#/definitions/isoDate" },
    "to": { "$ref": "#/definitions/isoDate" },
    "natal": { "type": "object", "required": ["lagna_sign", "moon_sign", "al_sign"] },
    "now": { "type": "object", "minProperties": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["planet", "from", "to", "sign", "house_from_lagna", "house_from_moon", "house_from_al", "over_natal", "influences_houses", "sav"],
        "properties": {
          "planet": { "enum": ["Su", "Mo", "Ma", "Me", "Ju", "Ve", "Sa", "Ra", "Ke"] },
          "from": { "$ref": "#/definitions/isoDate" },
          "to": { "$ref": "#/definitions/isoDate" },
          "sign": { "type": "integer", "minimum": 0, "maximum": 11 },
          "house_from_lagna": { "type": "integer", "minimum": 1, "maximum": 12 },
          "house_from_moon": { "type": "integer", "minimum": 1, "maximum": 12 },
          "house_from_al": { "type": "integer", "minimum": 1, "maximum": 12 },
          "over_natal": { "type": "array", "items": { "type": "string" } },
          "influences_houses": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
          "sav": { "type": "integer" },
          "bav": { "type": "integer" },
          "nak_segments": { "type": "array", "items": { "type": "object", "required": ["from", "to", "nak", "over_natal_nak"] } }
        }
      }
    },
    "double_transit": {
      "type": "array",
      "items": { "type": "object", "required": ["from", "to", "houses"] }
    },
    "sade_sati": { "type": "object", "required": ["now", "periods"] },
    "stations": { "type": "array" },
    "lunations": { "type": "array" }
  },
  "definitions": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
